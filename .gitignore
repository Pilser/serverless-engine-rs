# Ignore everything by default (whitelist style, mirroring the parent repo)
*

# Allow essential root files
!.gitignore
!.env.example
!AGENTS.md
!README.md
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml

# Allow cargo build configuration
!.cargo/
!.cargo/**

# Allow source code and docs
!crates/
!crates/**
!docs/
!docs/**


!MCP USAGE GUIDE.md


# Allow project tools (migration toolkit + HelixDB reference submodule)
!tools/
!tools/**
!tools/helixdb-skills/
!tools/helixdb-skills/**
!tools/migrate_iico/
!tools/migrate_iico/**

# Allow the embedded zerowrapper project (all of it except target/ + deploy binary)
!zerowrapper/
!zerowrapper/**
zerowrapper/target/
# the zw release binaries (DEPLOY-ALHEIB-AI/zw + legacy deploy/zw)
zerowrapper/deploy/DEPLOY-ALHEIB-AI/zw
zerowrapper/deploy/zw

# --- Still ignore build artifacts, runtime data and secrets (inside allowed dirs) ---
target/
**/target/
waos-data/
**/waos-data/
*.db
**/*.db
*.db-wal
**/*.db-wal
*.db-shm
**/*.db-shm
*.env
**/.env
.env.*
**/.env.*
!.env.example
token*
**/token*
*token*
**/*token*
*.log
**/*.log
.DS_Store
**/.DS_Store

# Python bytecode
__pycache__/
**/__pycache__/
*.pyc
.helix/
.env
tools/migrate_iico/data/done.json
tools/migrate_iico/data/storage/

# jerboa.env is the deploy config for the Jerboa site — track it
!zerowrapper/deploy/DEPLOY-ALHEIB-AI/jerboa.env

# stray photos
zerowrapper/*.jpg
.azure

# --- Production-folder: track only deploy config + .env; exclude binaries/data ---
# The host bind-mounts below hold the live srv binary, runtime DB caches and the
# MinIO object store — none of that should be in git. Only the portable deploy
# config (compose + Dockerfiles + README + .env) is committed.
!Production-folder/
!Production-folder/compose.yml
!Production-folder/Dockerfile.srv
!Production-folder/Dockerfile.zw
!Production-folder/README.md
!Production-folder/.env.example
!Production-folder/.env

# Track all .env files repo-wide (live secrets) — explicit request.
!**/.env

# deploy/ holds large runtime data (DB backups, node_modules, dist) — do NOT
# track the tree, but the request is to commit every .env file, so un-ignore
# only the .env files and the minimal parent dirs they need.
!deploy/
!deploy/.env
!deploy/iico/
# deploy/iico ships its own .git — ignore it so git does NOT treat the dir as a
# nested repository (which would otherwise be staged as a gitlink).
deploy/iico/.git/
deploy/iico/.git/**
!deploy/iico/.env

