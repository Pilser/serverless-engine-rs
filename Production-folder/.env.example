# Copy to .env and edit per machine. Everything here is optional — defaults
# are baked into compose.yml, but you SHOULD set secrets + host paths.

# --- project / naming ---
# COMPOSE_PROJECT_NAME=serverless-prod
# SRV_CONTAINER_NAME=serverless-srv
# ZW_CONTAINER_NAME=serverless-zw

# --- ports ---
# SRV_PORT=7070
# ZW_PORT=9033

# --- srv ---
# SRV_DB=helix
# SRV_HELIX_URL=http://172.25.0.1:7979
#   The daemon reaches HelixDB via the docker bridge gateway. On the DEFAULT
#   bridge that is 172.17.0.1, but compose custom networks use a different
#   subnet — check with: docker inspect <srv-container> | grep Gateway.
#   If HelixDB is a container on the same compose network, use its service name.
# SRV_PUBLIC_URL=http://192.168.1.100:7070
# SRV_HTTP_TIMEOUT_MS=15000
# SRV_SECRET_KEY=<32-byte key>

# --- zw ---
# SOCKET_DIR=/home/<user>/.zeroclaw/data
# AGENTS_DIR=/home/<user>/.zeroclaw/agents
# ZEROWRAPPER__ZEROCLAW_SOCKET=/home/<user>/.zeroclaw/data/daemon.sock
# ZEROWRAPPER_MCP_TOKEN=<token>
# ZEROWRAPPER_CH_WEB__AGENT=jerboa
