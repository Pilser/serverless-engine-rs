# zeroRapper Configuration via Environment Variables
# Alternative to config.toml. Lines starting with # are comments.
#
# Load priority:
#   1. config.toml (base config)
#   2. .env        (overrides config.toml values)
#
# Format:
#   ZEROWRAPPER__{KEY}=value            →  [zerowrapper] key = value
#   ZEROWRAPPER_{SECTION}__{KEY}=value  →  [zerowrapper.{section}] key = value

# ── Core (flat keys under [zerowrapper]) ──────────────────────
ZEROWRAPPER__ZEROCLAW_SOCKET=/tmp/.zeroclaw/daemon.sock
ZEROWRAPPER__DB_PATH=./data/zerowrapper.db
ZEROWRAPPER__CACHE_DIR=./data/cache

# ── Web channel (section [zerowrapper.ch_web]) ─────────────────
ZEROWRAPPER_CH_WEB__AGENT=craw
ZEROWRAPPER_CH_WEB__BIND=0.0.0.0:9090
ZEROWRAPPER_CH_WEB__ALLOWED_ORIGINS=["*"]
# ZEROWRAPPER_CH_WEB__DIST_PATH=./web/dist


# Pre-configured accounts: phone = {role, password}
ZEROWRAPPER_CH_WEB__ACCOUNTS={"256757337153" = {role = "owner", password = "admin123"}, "256700000000" = {role = "admin", password = "admin456"}}



# ── MCP discovery (section [zerowrapper.mcp]) ─────────────────
# ZEROWRAPPER_MCP__SERVER_NAME=zeroRapper
# ZEROWRAPPER_MCP__COMMAND=/path/to/zw
# ZEROWRAPPER_MCP__TRANSPORT=stdio
