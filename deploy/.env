# serverlessEngine-rs daemon configuration
# Read by docker-compose.yml (env_file) at container start.
# Paths are relative to the deploy/ folder (host side) and are mounted into the container.

# Bind address/port. SRV_HOST=0.0.0.0 so the daemon answers on ALL interfaces
# (container bridge + LAN). Do NOT hardcode localhost here — the port is exposed
# via docker-compose ports: "7070:7070" for access from inside and outside Docker.
SRV_HOST=0.0.0.0
SRV_PORT=7070

# Public base URL clients use to reach this daemon from outside the machine
# (OAuth redirect URIs, file links, etc). Set to your LAN IP or public domain.
SRV_PUBLIC_URL=http://192.168.1.100:7070

# Host-mounted paths (relative to deploy/). The binary and daemon data live here,
# so updating = replace the file + restart the container (no rebuild, no recreate).
#   ./srv            -> /usr/local/bin/srv     (the pre-built srv binary)
#   ./helix-iico-data -> /data                  (daemon data: boards + objects)
SRV_BIN=./srv
SRV_DATA_DIR=./helix-iico-data

# Storage backend: "helix" (default) or "memory".
SRV_DB=helix

# HelixDB server address. Runs on the host at port 7979; the container reaches it
# via the docker host gateway. On Linux the default docker bridge is 172.17.0.1.
# If helix runs inside a container instead, point this at its container name
# (e.g. http://helixdb:7979) and add helixdb to the compose networks.
SRV_HELIX_URL=http://172.17.0.1:7979

# Outbound HTTP call timeout in milliseconds (call action / jobs / recipes).
SRV_HTTP_TIMEOUT_MS=15000

# Master key for at-rest secret encryption (AES-256-GCM). 32 bytes.
# If unset, a dev fallback key is used (do not use in production).
SRV_SECRET_KEY=
