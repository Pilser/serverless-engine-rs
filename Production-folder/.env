# Production-folder environment — edit per machine.
# Paths may be RELATIVE to this file (they resolve against the compose file's
# directory). Absolute paths also work and override the relative defaults.

# --- project / naming ---
COMPOSE_PROJECT_NAME=serverless-prod
MINIO_CONTAINER_NAME=serverless-minio
HELIX_CONTAINER_NAME=serverless-helixdb
SRV_CONTAINER_NAME=serverless-srv
ZW_CONTAINER_NAME=serverless-zw

# --- ports ---
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9001
HELIX_PORT=7979
SRV_PORT=7070
ZW_PORT=9033

# --- minio (object store) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- srv (serverless engine daemon) ---
# Storage backend: helix (default) or memory
SRV_DB=helix
# HelixDB is a compose service on the same network — the compose file overrides
# SRV_HELIX_URL to http://helixdb:8080. This var is only the env_file fallback.
SRV_HELIX_URL=http://helixdb:8080
# Public base URL clients use from outside (OAuth redirects, file links).
SRV_PUBLIC_URL=http://192.168.1.100:7070
SRV_HTTP_TIMEOUT_MS=15000
# 32-byte master key for at-rest secret encryption. Set a real one in prod.
SRV_SECRET_KEY=

# --- zw (zeroclaw bridge / Jerboa chat) ---
# The zeroclaw daemon socket + agent workspaces live on the HOST (they are
# mounted into the zw container). Point these at the machine's paths.
SOCKET_DIR=/home/vox/.zeroclaw/data
AGENTS_DIR=/home/vox/.zeroclaw/agents
ZEROWRAPPER__ZEROCLAW_SOCKET=/home/vox/.zeroclaw/data/daemon.sock
ZEROWRAPPER_MCP_TOKEN=mcp_b5ec167eaf4017568eaeba43bac7629a
ZEROWRAPPER_CH_WEB__AGENT=jerboa
