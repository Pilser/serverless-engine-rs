# --- Microsoft 365 (Entra ID) integration ---
# Used by microsoftService.ts for Graph API provisioning (create mailbox on user creation)
# and Microsoft 365 mail sending. These MUST match the Entra app used for SSO above.
# IMPORTANT: MICROSOFT_TENANT_ID must be the app's HOME tenant (not just any tenant the app
# is visible in). Get it from Azure portal -> App registration -> Overview -> Directory (tenant) ID.
MICROSOFT_TENANT_ID="9f6c3b16-afff-4f28-9335-e6b449664d16"
MICROSOFT_CLIENT_ID="581575a4-1fde-4f0c-96a9-4e4a4c2f1395"
MICROSOFT_CLIENT_SECRET="OkB8Q~LoRk1tMIMlIF_V8bBmFH~J~vE3tdDxgcg."
# Verified M365 domain used for user UPNs (must be a domain already added/verified in the tenant).
MICROSOFT_DOMAIN="sised.sc.ug"
# License SKU to assign on provisioning (enables Exchange mailbox). List via Graph
# GET /subscribedSkus once you can obtain a token. Empty = no license assigned.
MICROSOFT_LICENSE_SKU_ID=""
# Sender UPN (an existing licensed user in the tenant) used when sending mail via Graph Mail.Send.
MICROSOFT_SENDER_UPN=""
