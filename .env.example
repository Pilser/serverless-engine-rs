# serverlessEngine-rs daemon configuration
# Copy to .env and edit, OR pass these as real environment variables.
# For Docker/CI, just set the env vars on the container (no .env file needed):
#   docker run -e SRV_PORT=8080 -e SRV_DATA_DIR=/data -e SRV_SECRET_KEY=... image
# Precedence: real env var > .env file > default.

# Bind host/address for the daemon (REST + MCP + WS + SSE).
SRV_HOST=127.0.0.1
SRV_PORT=7070

# Data directory for object store + local caches (boards live in HelixDB).
SRV_DATA_DIR=data

# Storage backend: "helix" (default, HelixDB via POST /v2/query) or "memory".
SRV_DB=helix

# HelixDB base URL (the /v2/query endpoint).
SRV_HELIX_URL=http://127.0.0.1:7979

# Outbound HTTP call timeout in milliseconds (call action / jobs / recipes).
SRV_HTTP_TIMEOUT_MS=15000

# Master key for at-rest secret encryption (AES-256-GCM). 32 bytes.
# If unset, a dev fallback key is used (do not use in production).
SRV_SECRET_KEY=
